# Supabase project credentials (Project Settings > API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Base URL used to build public profile links and QR codes (no trailing slash)
VITE_APP_URL=http://localhost:5173

# Optional: only needed if/when a separate FastAPI backend is deployed (see /backend)
VITE_API_URL=http://localhost:8000

# Storage bucket names (defaults match supabase/migrations/0001_init.sql)
VITE_STORAGE_BUCKET_PROFILE=profile-images
VITE_STORAGE_BUCKET_COVER=cover-images
VITE_STORAGE_BUCKET_LOGO=business-logos
VITE_STORAGE_BUCKET_PORTFOLIO=portfolio-images
VITE_STORAGE_BUCKET_CARD=card-assets
VITE_STORAGE_BUCKET_QR=qr-assets
